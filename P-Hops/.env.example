# Copy to .env.local (local) and add the same names in Vercel -> Project Settings -> Environment Variables.
# Every variable is optional for local development: without the Supabase ones the dev server uses an in-memory store.
# In production, missing Supabase variables make crowd reports / comments answer 503 (the rest of the app keeps working).

# ---- Supabase (Project Settings -> API) ------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public key: used for read-only queries, protected by Row Level Security
SUPABASE_ANON_KEY=
# The NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY names are accepted as fallbacks for the two
# variables above (only the server reads them; browser code never does). Set either spelling, not both.
# SECRET. Server only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Privacy / abuse protection ---------------------------------------------------------------------------------
# Random string (e.g. `openssl rand -hex 32`). Salts the hash of device ids stored with reports/comments.
# If unset in production the salt is derived from SUPABASE_SERVICE_ROLE_KEY (works, but set this explicitly).
DEVICE_HASH_SALT=

# ---- SEO ---------------------------------------------------------------------------------------------------------
# Canonical origin for URLs, Open Graph and the sitemap, no trailing slash. Defaults to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Uncomment to keep the site out of search engines (robots.txt + noindex meta + empty sitemap), e.g. before launch.
# Vercel preview deployments are always noindex, no setting needed.
# SITE_NOINDEX=true
